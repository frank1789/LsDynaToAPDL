# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true

[*.py]
indent_size = 4
trim_trailing_whitespace = true

[CMakeLists.txt, *.cmake]
indent_size = 4
trim_trailing_whitespace = true

[*.{c, cpp, cc, cxx, h, hpp, hh, hxx}]
indent_size = 2
trim_trailing_whitespace = true
